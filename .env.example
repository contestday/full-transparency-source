# Full Transparency — environment variables
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. NEVER commit real values.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" key. Safe in the browser ONLY because RLS is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- FollowMee (followmee.com → Account → API) --------------------------------
FOLLOWMEE_API_KEY=
FOLLOWMEE_USERNAME=
FOLLOWMEE_DEVICE_ID=
# Minutes without a new position before the GPS feed is flagged stale.
STALE_AFTER_MINUTES=30
# Optional: limit (hours) on holding the live status through GPS silence. Empty = no limit.
STATIONARY_HOLD_HOURS=
# Private admin alert when FollowMee has been silent this many hours.
ADMIN_SILENCE_ALERT_HOURS=24

# --- Shared secrets (generate with: openssl rand -hex 32) ---------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
# Optional: key for watchers' opted-in red/purple alerts (defaults to CRON_SECRET).
# Changing it switches those alerts off until each watcher opens their page again.
WATCH_SEAL_SECRET=
# Bearer token for POST /api/locations/ingest (dedicated worker / device bridge).
GPS_INGEST_SECRET=
# Salt for hashing visitor IPs used in rate limiting.
RATE_LIMIT_SALT=

# --- Maps ---------------------------------------------------------------------
# Any MapLibre style URL. Default: OpenFreeMap "liberty" (no key needed).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL identifying you to push services.
VAPID_SUBJECT=mailto:admin@example.com

# --- Optional email fallback via Resend ---------------------------------------
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# --- Misc ---------------------------------------------------------------------
APP_BASE_URL=https://your-domain.example
# Bounding box for anonymous area submissions: minLat,minLng,maxLat,maxLng
# Default covers Great Britain, Northern Ireland and the Channel Islands.
GEOFENCE_BOUNDS=49.0,-8.7,61.0,2.0

# Optional: your Incogneato page for anonymous messages (shown on /report)
NEXT_PUBLIC_INCOGNEATO_URL=
# Optional: Incogneato box ID (from their embed code, e.g. var mybox = "...") for the floating button
NEXT_PUBLIC_INCOGNEATO_BOX=

# Public source-code URL shown on the Privacy page (e.g. https://github.com/<owner>/<repo>)
NEXT_PUBLIC_SOURCE_URL=
